--!strict
-- Medication table inspired by KAT pharmacy. Effects ramp up to `peak` seconds then decay to zero at `duration`.

export type MedDef = {
	name: string,
	pain: number?, -- pain suppression at peak (0-1)
	hr: { number }?, -- heart rate adjustment range at peak
	resistance: number?, -- peripheral resistance adjustment at peak
	peak: number,
	duration: number,
	maxDose: number, -- doses in system before overdose risk
	overdose: string?, -- "Opioid" | "Tachy" | "Hypotension" | "Sedation"
	opioid: number?, -- respiratory depression at peak (0-1)
	coagulation: number?, -- bleeding reduction at peak (0-1)
	antiarrhythmic: boolean?,
	vasopressor: boolean?,
	sedative: boolean?,
	wakes: boolean?,
	route: string, -- "IM" | "IV" | "Oral" | "Inhaled"
	incompatible: { string }?,
}

